<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="HRApplicantSystem.UI.Views.MainWindow"
        Title="HR Applicant System - Login"
        Background="#F3F4F6">

    <Grid RowDefinitions="*, Auto, *" ColumnDefinitions="*, 400, *">
        <Border Grid.Row="1" Grid.Column="1" 
                Background="White" 
                CornerRadius="12" 
                Padding="30" 
                BoxShadow="0 4 20 0 #20000000">
            
            <StackPanel VerticalAlignment="Center" Spacing="18">
                <StackPanel Spacing="5" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="WELCOME BACK" 
                               FontSize="24" 
                               FontWeight="Heavy" 
                               Foreground="#1E3A8A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Log in to your Applicant Account" 
                               FontSize="12" 
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Email Address" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                    <TextBox Name="EmailInput" 
                             Watermark="username@email.com" 
                             Height="40" 
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Password" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                    <TextBox Name="PasswordInput" 
                             PasswordChar="*" 
                             Watermark="••••••••" 
                             Height="40" 
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button Name="LoginButton" 
                        Content="Sign In" 
                        Background="#2563EB" 
                        Foreground="White" 
                        FontWeight="Bold"
                        FontSize="15"
                        Height="42"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,15,0,0"/>

                <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,10,0,5"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                    <TextBlock Text="Don't have an account?" Foreground="#6B7280" FontSize="13"/>
                    <TextBlock Name="RegisterLink" 
                               Text="Register here" 
                               Foreground="#2563EB" 
                               FontWeight="SemiBold"
                               FontSize="13"
                               Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>