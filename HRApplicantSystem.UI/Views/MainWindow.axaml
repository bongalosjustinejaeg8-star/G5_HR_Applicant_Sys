<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
        xmlns:views="using:HRApplicantSystem.UI.Views"
        x:Class="HRApplicantSystem.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HR Applicant System"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="vm:RegisterViewModel">
            <views:RegisterView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ProfileViewModel">
            <views:ProfileView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DocumentsViewModel">
            <views:DocumentsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:StatusTrackingViewModel">
            <views:StatusTrackingView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="250, *">
        
        <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2D2D2D" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel Spacing="20">
                <TextBlock Text="HR System" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Margin="0,10,0,20"/>
               <Button Content="📊 Dashboard" 
        Command="{Binding NavigateToDashboardCommand}"
        HorizontalAlignment="Stretch" Padding="12,10" Background="Transparent" Foreground="#FFFFFF"/>

        <Button Content="🪪 My Profile" 
                Command="{Binding NavigateToProfileCommand}"
                HorizontalAlignment="Stretch" Padding="12,10" Background="Transparent" Foreground="#FFFFFF"/>

        <Button Content="📄 My Documents" 
                Command="{Binding NavigateToDocumentsCommand}"
                HorizontalAlignment="Stretch" Padding="12,10" Background="Transparent" Foreground="#FFFFFF"/>

        <Button Content="⏳ Status Tracking" 
                Command="{Binding NavigateToStatusTrackingCommand}"
                HorizontalAlignment="Stretch" Padding="12,10" Background="Transparent" Foreground="#FFFFFF"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>

    </Grid>
</Window>