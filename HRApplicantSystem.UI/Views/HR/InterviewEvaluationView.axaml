<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.HR"
             xmlns:m="using:HRApplicantSystem.Data.Models"
             x:Class="HRApplicantSystem.UI.Views.HR.InterviewEvaluationView"
             x:DataType="vm:InterviewEvaluationViewModel">

  <StackPanel Margin="20">
    <TextBlock Text="Interview Evaluation" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

    <ListBox ItemsSource="{Binding Applications}"
             SelectedItem="{Binding SelectedApplication}"
             Height="200"
             Margin="0 0 0 10">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="m:Application">
          <StackPanel Margin="5">
            <TextBlock Text="{Binding Status}" FontWeight="Bold"/>
            <TextBlock Text="{Binding SubmittedAt}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Text="Evaluation Details" FontSize="16" FontWeight="Bold" Margin="0 10 0 5"/>

    <TextBlock Text="Score (1-100)" Margin="0 0 0 5"/>
    <TextBox Text="{Binding Score}"
             PlaceholderText="Enter score..."
             Margin="0 0 0 10"/>

    <TextBlock Text="Remarks" Margin="0 0 0 5"/>
    <TextBox Text="{Binding Remarks}"
             PlaceholderText="Enter evaluation remarks..."
             Height="80"
             AcceptsReturn="True"
             Margin="0 0 0 10"/>

    <TextBlock Text="Result" Margin="0 0 0 5"/>
    <RadioButton Content="Pass" IsChecked="True" Margin="0 0 0 5"/>
    <RadioButton Content="Fail" Margin="0 0 0 10"/>

    <TextBlock Text="Recommendation" Margin="0 0 0 5"/>
    <TextBox Text="{Binding Recommendation}"
             PlaceholderText="Enter recommendation..."
             Margin="0 0 0 10"/>

    <TextBlock Text="{Binding Message}" Foreground="Green" Margin="0 0 0 10"/>

    <Button Content="Save Evaluation"
            HorizontalAlignment="Right"/>
  </StackPanel>
</UserControl>