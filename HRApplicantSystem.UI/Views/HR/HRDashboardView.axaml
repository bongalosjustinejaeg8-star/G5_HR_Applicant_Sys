<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.HR"
             x:Class="HRApplicantSystem.UI.Views.HR.HRDashboardView"
             x:DataType="vm:HRDashboardViewModel"
             Background="#0B0B0F">

  <UserControl.Resources>
    <SolidColorBrush x:Key="Card"        Color="#15151C"/>
    <SolidColorBrush x:Key="CardBorder"  Color="#26262F"/>
    <SolidColorBrush x:Key="TextDim"     Color="#9CA3AF"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.tile">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E1E26"/>
      <Setter Property="BorderBrush" Value="#3A3A47"/>
    </Style>

    <Style Selector="Button.stat.blue">   <Setter Property="Background" Value="#1E88E5"/><Setter Property="BorderBrush" Value="#1976D2"/></Style>
    <Style Selector="Button.stat.orange"> <Setter Property="Background" Value="#FB8C00"/><Setter Property="BorderBrush" Value="#EF6C00"/></Style>
    <Style Selector="Button.stat.purple"> <Setter Property="Background" Value="#8E24AA"/><Setter Property="BorderBrush" Value="#6A1B9A"/></Style>
    <Style Selector="Button.stat.green">  <Setter Property="Background" Value="#43A047"/><Setter Property="BorderBrush" Value="#2E7D32"/></Style>

    <Style Selector="Button.logout">
      <Setter Property="Background" Value="#1F1F27"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#33333D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#33333D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="16">

    <!-- Header -->
    <Border Grid.Row="0" CornerRadius="14" Padding="22"
            Background="#111119" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Spacing="4">
          <TextBlock Text="HR Dashboard" FontSize="24" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="{Binding WelcomeMessage}" Foreground="{StaticResource TextDim}"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="logout" Content="Logout" Command="{Binding Logout}"/>
      </Grid>
    </Border>

    <!-- Uniform tiles grid: 6 equal columns, 2 rows, small spacing -->
    <UniformGrid Grid.Row="1" Columns="6" Rows="1"
                 HorizontalAlignment="Stretch">
      <UniformGrid.Styles>
        <Style Selector="Button"><Setter Property="Margin" Value="6"/></Style>
      </UniformGrid.Styles>

      <Button Classes="tile" Command="{Binding GoToJobVacancyMgmt}">
        <StackPanel Spacing="6">
          <TextBlock Text="📄" FontSize="22"/>
          <TextBlock Text="Job Vacancy" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Add • Edit • Remove" Foreground="{StaticResource TextDim}" FontSize="12"/>
        </StackPanel>
      </Button>

      <Button Classes="tile" Command="{Binding GoToReports}">
        <StackPanel Spacing="6">
          <TextBlock Text="📊" FontSize="22"/>
          <TextBlock Text="Reports" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Audit Trail" Foreground="{StaticResource TextDim}" FontSize="12"/>
        </StackPanel>
      </Button>

      <Button Classes="tile stat blue">
        <StackPanel Spacing="6">
          <TextBlock Text="👥" FontSize="20" Foreground="White"/>
          <TextBlock Text="{Binding TotalApplicants}" FontSize="26" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Total Applicants" Foreground="White" Opacity="0.85" FontSize="12"/>
        </StackPanel>
      </Button>
        
      <Button Classes="tile stat orange">
        <StackPanel Spacing="6">
          <TextBlock Text="⏱" FontSize="20" Foreground="White"/>
          <TextBlock Text="{Binding PendingReview}" FontSize="26" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Pending Review" Foreground="White" Opacity="0.85" FontSize="12"/>
        </StackPanel>
      </Button>

      <Button Classes="tile stat purple">
        <StackPanel Spacing="6">
          <TextBlock Text="★" FontSize="20" Foreground="White"/>
          <TextBlock Text="{Binding Shortlisted}" FontSize="26" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Shortlisted" Foreground="White" Opacity="0.85" FontSize="12"/>
        </StackPanel>
      </Button>

      <Button Classes="tile stat green">
        <StackPanel Spacing="6">
          <TextBlock Text="✓" FontSize="20" Foreground="White"/>
          <TextBlock Text="{Binding Accepted}" FontSize="26" FontWeight="Bold" Foreground="White"/>
          <TextBlock Text="Accepted" Foreground="White" Opacity="0.85" FontSize="12"/>
        </StackPanel>
      </Button>
    </UniformGrid>

    <!-- Recent activities -->
    <Border Grid.Row="2" CornerRadius="14" Padding="20"
            Background="#111119" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Recent Activities" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Latest actions across the system" Foreground="{StaticResource TextDim}" FontSize="12"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost" Content="⟳  Refresh" Command="{Binding RefreshCommand}"/>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding RecentActivities}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#181820" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,0"
                      CornerRadius="10" Padding="12" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Description}" Foreground="White"/>
                  <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource TextDim}" FontSize="11"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
