<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.HR"
             x:Class="HRApplicantSystem.UI.Views.HR.HiringDecisionView"
             x:DataType="vm:HiringDecisionViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style Selector="Button.back">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="BorderBrush"     Value="#D1D5DB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius"    Value="6"/>
      <Setter Property="Padding"         Value="12,7"/>
      <Setter Property="FontSize"        Value="13"/>
      <Setter Property="Foreground"      Value="#374151"/>
    </Style>
    <Style Selector="Button.submit">
      <Setter Property="Background"      Value="#1D4ED8"/>
      <Setter Property="Foreground"      Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius"    Value="8"/>
      <Setter Property="Padding"         Value="20,10"/>
      <Setter Property="FontSize"        Value="14"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>
    <Style Selector="Button.submit:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0" Content="← Back" Command="{Binding GoBackCommand}"
                Classes="back" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" Text="Hiring Decisions"
                   FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/>
      </Grid>

      <!-- Role restriction warning -->
      <Border IsVisible="{Binding RoleWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Background="#FEF2F2" BorderBrush="#FECACA"
              BorderThickness="1" CornerRadius="8" Padding="14,12">
        <TextBlock Text="{Binding RoleWarning}" FontSize="14"
                   Foreground="#DC2626" FontWeight="Medium"/>
      </Border>

      <Grid ColumnDefinitions="*,380" ColumnSpacing="16">

        <!-- Left: applicant list -->
        <StackPanel Grid.Column="0" Spacing="10">
          <TextBlock Text="Eligible applicants" FontSize="14" FontWeight="Medium" Foreground="#6B7280"/>

          <!-- Table header -->
          <Border Background="#F9FAFB" BorderBrush="#E5E7EB"
                  BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="14,10">
            <Grid ColumnDefinitions="*,*,Auto">
              <TextBlock Grid.Column="0" Text="Full name"  FontSize="12" FontWeight="Medium" Foreground="#6B7280"/>
              <TextBlock Grid.Column="1" Text="Position"   FontSize="12" FontWeight="Medium" Foreground="#6B7280"/>
              <TextBlock Grid.Column="2" Text="Status"     FontSize="12" FontWeight="Medium" Foreground="#6B7280" Width="120"/>
            </Grid>
          </Border>

          <ListBox ItemsSource="{Binding Applicants}"
                   SelectedItem="{Binding SelectedApplicant}"
                   Background="White" BorderBrush="#E5E7EB"
                   BorderThickness="1,0,1,1" CornerRadius="0,0,10,10">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="14,12" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="*,*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding FullName}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="13"
                               Foreground="#6B7280" VerticalAlignment="Center"/>
                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE"
                            BorderThickness="1" CornerRadius="999" Padding="10,3" Width="110">
                      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#1D4ED8"
                                 HorizontalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <!-- Right: decision panel -->
        <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="12" Padding="20">
          <StackPanel Spacing="16">

            <TextBlock Text="Final Decision" FontSize="16" FontWeight="Medium"/>

            <!-- Decision radio buttons -->
            <StackPanel Spacing="10">
              <Border Background="White" BorderBrush="#D1FAE5" BorderThickness="1"
                      CornerRadius="8" Padding="14,12">
                <RadioButton Content="✅  Accept applicant"
                             IsChecked="{Binding Decision, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                             GroupName="Decision"
                             FontSize="14" Foreground="#059669"/>
              </Border>
              <Border Background="White" BorderBrush="#FEE2E2" BorderThickness="1"
                      CornerRadius="8" Padding="14,12">
                <RadioButton Content="❌  Reject applicant"
                             GroupName="Decision"
                             FontSize="14" Foreground="#DC2626"/>
              </Border>
            </StackPanel>

            <!-- Remarks -->
            <StackPanel Spacing="6">
              <TextBlock Text="Remarks" FontSize="13" Foreground="#6B7280"/>
              <TextBox Text="{Binding Remarks}"
                       PlaceholderText="Enter decision remarks..."
                       Height="100"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       CornerRadius="8"/>
            </StackPanel>

            <!-- Message -->
            <Border IsVisible="{Binding HasMessage}"
                    Background="#EFF6FF" BorderBrush="#BFDBFE"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
              <TextBlock Text="{Binding Message}" FontSize="13"
                         Foreground="#1D4ED8" TextWrapping="Wrap"/>
            </Border>

            <!-- Submit -->
            <Button Content="Submit Decision"
                    Command="{Binding SubmitDecisionCommand}"
                    IsEnabled="{Binding CanDecide}"
                    Classes="submit"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"/>

          </StackPanel>
        </Border>

      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>