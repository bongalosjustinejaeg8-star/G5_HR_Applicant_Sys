<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="HRApplicantSystem.UI.Views.StatusTrackingView"
             x:DataType="vm:StatusTrackingViewModel">

    <Border Background="#121212" Padding="30">
        <ScrollViewer>
            <StackPanel Spacing="25" MaxWidth="700" HorizontalAlignment="Left">
                
                <StackPanel Spacing="5">
                    <TextBlock Text="Application Status Tracking" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Monitor the live progress and updates of your application." Foreground="#AAAAAA" FontSize="14"/>
                </StackPanel>

                <Separator Background="#2D2D2D" Height="1"/>

                <Border Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12" Padding="25">
                    <StackPanel Spacing="20">
                        <TextBlock Text="📋 Application Progress" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                        
                        <StackPanel Spacing="15">
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Grid.Column="0" Width="20" Height="20" Fill="#00CC66" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="✓ Application Submitted" Foreground="#00CC66" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Your profile and requirements have been safely received." Foreground="#AAAAAA" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Grid.Column="0" Width="20" Height="20" Fill="#00CC66" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="✓ Under HR Review" Foreground="#00CC66" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="Initial document screening and background check." Foreground="#AAAAAA" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Grid.Column="0" Width="20" Height="20" Fill="#FFCC00" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="➔ Interview Scheduled (Current)" Foreground="#FFCC00" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding InterviewSchedule}" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" Margin="0,2"/>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Grid.Column="0" Width="20" Height="20" Fill="#3D3D3D" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                    <TextBlock Text="Final Status Result" Foreground="#888888" FontSize="14"/>
                                    <TextBlock Text="The final decision will be posted once interviews are concluded." Foreground="#888888" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    
                    <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="💬 HR Evaluation Remarks" Foreground="#AAAAAA" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HrRemarks}" Foreground="#FFFFFF" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🏆 Final Decision Outcome" Foreground="#AAAAAA" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FinalResult}" Foreground="#FFCC00" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>