<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid Background="#121212">
        <Border Background="#1E1E1E" Width="400" Padding="30" CornerRadius="8" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#2D2D2D" BorderThickness="1">
            <StackPanel Spacing="15">
                <TextBlock Text="Applicant Login" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Allows registered applicants to access their account." Foreground="#888888" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                
                <Separator Background="#2D2D2D" Margin="0,10"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Username" Foreground="#888888" FontSize="12"/>
                    <TextBox Text="{Binding Username}" Background="#2D2D2D" Foreground="White"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Password" Foreground="#888888" FontSize="12"/>
                    <TextBox Text="{Binding Password}" PasswordChar="*" Background="#2D2D2D" Foreground="White"/>
                </StackPanel>

                <Button Content="Sign In" Command="{Binding LoginCommand}" 
                        Background="#007ACC" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" Margin="0,10,0,0"/>

                <Button Content="Create an Account" Command="{Binding NavigateToRegisterCommand}" 
                        Background="Transparent" Foreground="#007ACC" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>