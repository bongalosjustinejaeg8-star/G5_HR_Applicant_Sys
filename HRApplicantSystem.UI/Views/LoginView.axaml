<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HRApplicantSystem.UI.Views.LoginView">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Width="300">
        <TextBlock Text="HR Applicant System" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" />
        
        <TextBlock Text="Username" FontSize="12" />
        <TextBox x:Name="UsernameTextBox" Watermark="Enter your username" Padding="10" Height="40" />
        
        <TextBlock Text="Password" FontSize="12" Margin="0,10,0,0" />
        <TextBox x:Name="PasswordTextBox" Watermark="Enter your password" Padding="10" Height="40" />
        
        <Button Content="Login" HorizontalAlignment="Stretch" Padding="10" Height="40" Margin="0,20,0,0" />
    </StackPanel>
</UserControl>
