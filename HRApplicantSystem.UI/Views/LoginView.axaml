<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.LoginView"
             x:DataType="vm:LoginViewModel">
             
    <StackPanel Margin="20">
        <TextBlock Text="Login Page" FontSize="24"/>
        <TextBox PlaceholderText="Email" Margin="0,10,0,0"/>
        <TextBox PlaceholderText="Password" PasswordChar="●" Margin="0,10,0,0"/>
        <Button Content="Sign In" Margin="0,10,0,0"/>
    </StackPanel>

</UserControl>