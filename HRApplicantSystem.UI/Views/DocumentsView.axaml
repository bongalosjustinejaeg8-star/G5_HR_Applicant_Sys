<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel">

    <ScrollViewer Background="#121212">
        <StackPanel Margin="30" Spacing="20" MaxWidth="750" HorizontalAlignment="Center">
            
            <Border Background="#1E1E1E" Padding="25" CornerRadius="8" BorderBrush="#2D2D2D" BorderThickness="1">
                <StackPanel Spacing="20">
                    <TextBlock Text="My Documents &amp; Requirements" Foreground="#007ACC" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Allows document upload, recording, and replacement before HR review." Foreground="#888888" FontSize="13" Margin="0,-10,0,5"/>
                    <Separator Background="#2D2D2D"/>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Curriculum Vitae / Resume (Required)" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding ResumePath}" IsReadOnly="True" Background="#2D2D2D" Foreground="#888888"/>
                            <Button Grid.Column="1" Content="📁 Choose File" Command="{Binding UploadResumeCommand}" Background="#007ACC" Foreground="White" Margin="10,0,0,0" Padding="15,10"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="10" Margin="0,10,0,0">
                        <TextBlock Text="Transcript of Records / Diploma (Optional)" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding DiplomaPath}" IsReadOnly="True" Background="#2D2D2D" Foreground="#888888"/>
                            <Button Grid.Column="1" Content="📁 Choose File" Command="{Binding UploadDiplomaCommand}" Background="#007ACC" Foreground="White" Margin="10,0,0,0" Padding="15,10"/>
                        </Grid>
                    </StackPanel>

                    <Separator Background="#2D2D2D" Margin="0,15,0,0"/>
                    
                    <Border Background="#2D2D2D" Padding="15" CornerRadius="5">
                        <TextBlock Text="{Binding UploadStatus}" Foreground="#007ACC" FontSize="13" HorizontalAlignment="Center" FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>