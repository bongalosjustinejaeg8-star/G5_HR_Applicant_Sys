<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="HRApplicantSystem.UI.Views.DocumentsView"
             x:DataType="vm:DocumentsViewModel">

    <Border Background="#121212" Padding="30">
        <ScrollViewer>
            <StackPanel Spacing="25" MaxWidth="700" HorizontalAlignment="Left">
                
                <StackPanel Spacing="5">
                    <TextBlock Text="Applicant Documents" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Upload and update your required employment documents below." Foreground="#AAAAAA" FontSize="14"/>
                </StackPanel>

                <Separator Background="#2D2D2D" Height="1"/>

                <Border Background="#1E1E1E" BorderBrush="#FFCC00" BorderThickness="1,0,0,0" Padding="15" CornerRadius="4">
                    <StackPanel Spacing="5">
                        <TextBlock Text="📌 HR Remarks on Documents:" Foreground="#FFCC00" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DocumentRemarks}" Foreground="#DDDDDD" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="15">
                        
                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="📄 Resume / CV" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Latest copy of your professional resume." Foreground="#AAAAAA" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ResumeStatus}" Foreground="#00CC66" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Grid.Column="2" Content="Re-upload" Command="{Binding UploadResumeCommand}" Background="#3D3D3D" Foreground="#FFFFFF" Padding="15,8" CornerRadius="6"/>
                        </Grid>
                        <Separator Background="#2D2D2D" Height="1"/>

                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="🪪 Valid Government ID" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Passport, Driver's License, or UMID." Foreground="#AAAAAA" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding IdStatus}" Foreground="#FF5555" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Grid.Column="2" Content="Upload File" Command="{Binding UploadIDCommand}" Background="#3D3D3D" Foreground="#FFFFFF" Padding="15,8" CornerRadius="6"/>
                        </Grid>
                        <Separator Background="#2D2D2D" Height="1"/>

                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="🎓 Transcript of Records (TOR)" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Official or temporary copy from your university." Foreground="#AAAAAA" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TorStatus}" Foreground="#FF5555" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Grid.Column="2" Content="Upload File" Command="{Binding UploadTORCommand}" Background="#3D3D3D" Foreground="#FFFFFF" Padding="15,8" CornerRadius="6"/>
                        </Grid>
                        <Separator Background="#2D2D2D" Height="1"/>

                        <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="📜 Training &amp; Seminar Certificates" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Optional certifications relevant to the job." Foreground="#AAAAAA" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CertificateStatus}" Foreground="#00CC66" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Grid.Column="2" Content="Re-upload" Command="{Binding UploadCertificateCommand}" Background="#3D3D3D" Foreground="#FFFFFF" Padding="15,8" CornerRadius="6"/>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>