<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.InterviewScheduleView">

  <StackPanel Margin="20">

    <TextBlock Text="Interview Scheduling" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

    <!-- Shortlisted Applicants List -->
    <TextBlock Text="Shortlisted Applicants" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
    <ListBox Name="ApplicantListBox" Height="200" Margin="0 0 0 10">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="5">
            <TextBlock Text="{Binding Status}" FontWeight="Bold"/>
            <TextBlock Text="{Binding SubmittedAt}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Interview Details -->
    <TextBlock Text="Interview Details" FontSize="16" FontWeight="Bold" Margin="0 10 0 5"/>

    <!-- Date and Time -->
    <TextBlock Text="Interview Date and Time" Margin="0 0 0 5"/>
    <DatePicker Name="InterviewDatePicker" Margin="0 0 0 10"/>

    <!-- Interviewer -->
    <TextBlock Text="Interviewer" Margin="0 0 0 5"/>
    <TextBox Name="InterviewerBox"
             Watermark="Enter interviewer name..."
             Margin="0 0 0 10"/>

    <!-- Mode -->
    <TextBlock Text="Mode" Margin="0 0 0 5"/>
    <ComboBox Name="ModeComboBox" Margin="0 0 0 10">
      <ComboBoxItem Content="Online"/>
      <ComboBoxItem Content="On-site"/>
    </ComboBox>

    <!-- Location -->
    <TextBlock Text="Location" Margin="0 0 0 5"/>
    <TextBox Name="LocationBox"
             Watermark="Enter location or meeting link..."
             Margin="0 0 0 10"/>

    <!-- Save Button -->
    <Button Name="SaveScheduleButton"
            Content="Save Interview Schedule"
            HorizontalAlignment="Right"
            Margin="0 10 0 0"/>

  </StackPanel>

</UserControl>