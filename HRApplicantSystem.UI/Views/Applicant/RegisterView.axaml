<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             x:Class="HRApplicantSystem.UI.Views.Applicant.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="15"
                Width="300">

        <TextBlock Text="Create Account"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Email" FontSize="12"/>
        <TextBox PlaceholderText="Enter your email"
                 Text="{Binding Email}"
                 Padding="10"
                 Height="40"/>

        <TextBlock Text="Create Password" FontSize="12"/>
        <TextBox PlaceholderText="Enter your password"
                 PasswordChar="*"
                 Text="{Binding Password}"
                 Padding="10"
                 Height="40"/>

        <TextBlock Text="Confirm Password" FontSize="12"/>
        <TextBox PlaceholderText="Enter your password"
                 PasswordChar="*"
                 Text="{Binding ConfirmPassword}"
                 Padding="10"
                 Height="40"/>

        <!-- error message shown when login fails -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Red"
                   HorizontalAlignment="Center"
                   IsVisible="{Binding HasError}"/>

        <Button Content="Register"
                Command="{Binding RegisterCommand}"
                HorizontalAlignment="Stretch"
                Padding="10"
                Height="40"
                Margin="0,20,0,0"/>

        <Button Content="Already have an account?"
                Command="{Binding GoToLoginCommand}"
                HorizontalAlignment="Stretch"
                Padding="10"
                Height="40"/>

        <Button Content="Back"
                Command="{Binding GoBackCommand}"
                HorizontalAlignment="Stretch"
                Padding="10"
                Height="40"/>

    </StackPanel>
</UserControl>