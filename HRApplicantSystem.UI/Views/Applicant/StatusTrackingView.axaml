<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             x:Class="HRApplicantSystem.UI.Views.Applicant.StatusTrackingView"
             x:DataType="vm:StatusTrackingViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5E5E5"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="0">

      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,20">
        <Button Grid.Column="0"
                Content="← Back"
                Command="{Binding GoBackCommand}"
                Padding="12,7"
                Margin="0,0,14,0"
                Background="Transparent"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="6"
                Foreground="#555555"/>
        <TextBlock Grid.Column="1"
                   Text="Application status tracking"
                   FontSize="20"
                   FontWeight="Medium"
                   VerticalAlignment="Center"/>
      </Grid>

      <!-- Current Status Card -->
      <Border Background="#F0FDF4"
              BorderBrush="#86EFAC"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16"
              Margin="0,0,0,20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="CURRENT STATUS"
                       FontSize="11"
                       Foreground="#6B7280"
                       FontWeight="Medium"/>
            <TextBlock Text="{Binding CurrentStatus}"
                       FontSize="18"
                       FontWeight="Medium"
                       Foreground="#16A34A"/>
            <TextBlock Text="{Binding LastUpdated, StringFormat='Last updated: {0}'}"
                       FontSize="12"
                       Foreground="#6B7280"/>
          </StackPanel>
          <Border Grid.Column="1"
                  Background="#DCFCE7"
                  BorderBrush="#86EFAC"
                  BorderThickness="1"
                  CornerRadius="999"
                  Padding="12,6"
                  VerticalAlignment="Center">
            <TextBlock Text="Active"
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="#16A34A"/>
          </Border>
        </Grid>
      </Border>

      <!-- Timeline Label -->
      <TextBlock Text="TIMELINE"
                 FontSize="11"
                 FontWeight="Medium"
                 Foreground="#6B7280"
                 Margin="0,0,0,14"/>

      <!-- Timeline List -->
      <ListBox ItemsSource="{Binding StatusHistory}"
               Background="Transparent"
               BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="{Binding StatusName}"
                             FontSize="14"
                             FontWeight="Medium"/>
                  <TextBlock Text="{Binding Details}"
                             FontSize="13"
                             Foreground="#6B7280"
                             TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding ChangedBy, StringFormat='By: {0}'}"
                               FontSize="12"
                               Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding ChangedDate}"
                               FontSize="12"
                               Foreground="#9CA3AF"/>
                    <TextBlock Text="{Binding ChangedTime}"
                               FontSize="12"
                               Foreground="#9CA3AF"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </StackPanel>
  </ScrollViewer>

</UserControl>