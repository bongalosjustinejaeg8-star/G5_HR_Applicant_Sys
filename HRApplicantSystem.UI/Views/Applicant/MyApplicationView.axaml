<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.Applicant.MyApplicationView"
             x:DataType="vm:MyApplicationViewModel">

  <ScrollViewer>
    <StackPanel Margin="20">

      <TextBlock Text="My Applications"
                 FontSize="24"
                 FontWeight="Bold"
                 Margin="0,0,0,20"/>

      <ListBox ItemsSource="{Binding Applications}"
               SelectedItem="{Binding SelectedApplication}">

        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,5"
                    Padding="10"
                    CornerRadius="5"
                    Background="#F0F0F0">

              <StackPanel>

                <TextBlock Text="{Binding ApplicationId}"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding VacancyId}"/>

                <TextBlock Text="{Binding Status}"/>

                <TextBlock Text="{Binding SubmittedAt}"/>

              </StackPanel>

            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>

      </ListBox>

      <Border Background="#F8F8F8"
              Margin="0,15,0,0"
              Padding="15"
              CornerRadius="5">

        <StackPanel>

          <TextBlock Text="Selected Application"
                     FontWeight="Bold"
                     FontSize="16"/>

          <TextBlock Text="{Binding SelectedApplication.ApplicationId}"/>

          <TextBlock Text="{Binding SelectedApplication.VacancyId}"/>

          <TextBlock Text="{Binding SelectedApplication.Status}"/>

          <TextBlock Text="{Binding SelectedApplication.SubmittedAt}"/>

          <TextBlock Text="{Binding Message}"
                     Margin="0,10,0,0"/>

          <Button Content="Submit Application"
                  Command="{Binding SubmitApplicationAsync}"
                  IsEnabled="{Binding IsEditable}"
                  Margin="0,10,0,0"/>

        </StackPanel>

      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>