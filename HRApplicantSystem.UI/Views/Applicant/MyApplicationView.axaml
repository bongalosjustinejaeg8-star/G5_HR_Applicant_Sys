<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.Applicant.MyApplicationView"
             x:DataType="vm:MyApplicationViewModel">

  <ScrollViewer>
    <StackPanel Margin="20">
      <TextBlock Text="My Application" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

      <!-- Application Summary -->
      <Border Background="#F0F0F0" Padding="15" CornerRadius="5" Margin="0 0 0 15">
        <StackPanel>
          <TextBlock Text="{Binding JobPosition}" FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="Status: {Binding ApplicationStatus}" Margin="0 5 0 0"/>
          <TextBlock Text="Submitted: {Binding SubmittedDate}" Margin="0 5 0 0"/>
        </StackPanel>
      </Border>

      <!-- Application Details -->
      <TextBlock Text="Application Details" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
      <StackPanel Background="#FFFACD" Padding="10" Margin="0 0 0 15">
        <TextBlock Text="{Binding ApplicationDetails}" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Submitted Documents -->
      <TextBlock Text="Submitted Documents" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
      <ListBox ItemsSource="{Binding SubmittedDocuments}" Height="200" Margin="0 0 0 15">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="5">
              <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
              <TextBlock Text="Type: {Binding DocumentType}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Feedback/Comments from HR -->
      <TextBlock Text="HR Feedback" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
      <TextBlock Text="{Binding HRFeedback}" TextWrapping="Wrap" Padding="10" Background="#E3F2FD" CornerRadius="5" Margin="0 0 0 15"/>

      <Button Content="Download Application" HorizontalAlignment="Left"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>