  <UserControl x:CompileBindings="False"
              xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
              x:Class="HRApplicantSystem.UI.Views.Applicant.MyApplicationView"
              x:DataType="vm:MyApplicationViewModel">

    <UserControl.Styles>
      <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="Black"/>
      </Style>
    </UserControl.Styles>

    <ScrollViewer>

      <StackPanel Margin="20"
                  Spacing="15">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*">

          <Button Grid.Column="0"
                  Content="← Back to Dashboard"
                  Command="{Binding GoBackCommand}"
                  Margin="0,0,15,0"/>

          <TextBlock Grid.Column="1"
                    Text="My Applications"
                    FontSize="24"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>

        </Grid>

        <!-- Applications List -->
        <ListBox ItemsSource="{Binding Applications}"
                SelectedItem="{Binding SelectedApplication}">

          <ListBox.ItemTemplate>
            <DataTemplate>

              <Border Margin="0,5"
                      Padding="12"
                      CornerRadius="8"
                      Background="#F0F0F0">

                <StackPanel Spacing="4">

                  <TextBlock Text="{Binding ApplicationId}"
                            FontWeight="Bold"/>

                  <TextBlock Text="{Binding VacancyId}"/>

                  <TextBlock Text="{Binding Status}"/>

                  <TextBlock Text="{Binding SubmittedAt}"/>

                </StackPanel>

              </Border>

            </DataTemplate>
          </ListBox.ItemTemplate>

        </ListBox>

        <!-- Selected Application -->
        <Border Background="#F8F8F8"
                Margin="0,10,0,0"
                Padding="15"
                CornerRadius="8">

          <StackPanel Spacing="8">

            <TextBlock Text="Selected Application"
                      FontWeight="Bold"
                      FontSize="18"/>

            <Separator/>

            <TextBlock Text="{Binding SelectedApplication.ApplicationId}"/>

            <TextBlock Text="{Binding SelectedApplication.VacancyId}"/>

            <TextBlock Text="{Binding SelectedApplication.Status}"/>

            <TextBlock Text="{Binding SelectedApplication.SubmittedAt}"/>

            <TextBlock Text="{Binding Message}"
                      Margin="0,8,0,0"/>

            <Button Content="Submit Application"
                    Command="{Binding SubmitApplicationAsync}"
                    IsEnabled="{Binding IsEditable}"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"/>

          </StackPanel>

        </Border>

      </StackPanel>

    </ScrollViewer>

  </UserControl>