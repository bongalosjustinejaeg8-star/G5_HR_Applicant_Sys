<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             x:Class="HRApplicantSystem.UI.Views.Applicant.MyDocumentsView"
             x:DataType="vm:MyDocumentsViewModel">

  <StackPanel Margin="20">
<TextBlock Text="My Documents" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

<TextBlock Text="{Binding Message}" 
           IsVisible="{Binding HasMessage}"
           Foreground="Red"
           TextWrapping="Wrap"
           Margin="0 0 0 10"/>
    <ComboBox ItemsSource="{Binding RequirementTypes}"
              SelectedItem="{Binding SelectedRequirementType}"
              DisplayMemberBinding="{Binding Name}"
              PlaceholderText="Select document type"
              HorizontalAlignment="Left"
              Width="220"
              Margin="0 0 0 10"/>

    <Button Content="+ Upload Document" 
        Command="{Binding UploadDocumentCommand}" 
        HorizontalAlignment="Left" Margin="0 0 0 10"/>
    <Button Content="+ Record Video" 
        Command="{Binding RecordVideoCommand}"
        HorizontalAlignment="Left" Margin="0 0 0 15"/>

    <TextBlock Text="Uploaded Documents" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
    <ListBox ItemsSource="{Binding Documents}"
         SelectedItem="{Binding SelectedDocument}"
         Height="300"
         Margin="0 0 0 10">

    <ListBox.ItemTemplate>
        <DataTemplate>
            <StackPanel Margin="5">
                <TextBlock Text="{Binding FilePath}"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding RequirementTypeId}"/>

                <TextBlock Text="{Binding SubmittedAt}"/>

                <TextBlock Text="{Binding Status}"/>
            </StackPanel>
        </DataTemplate>
    </ListBox.ItemTemplate>

</ListBox>

    <Grid ColumnDefinitions="*,*" Margin="0 10 0 0">
      <Button Grid.Column="0" 
              Content="Download" 
              Command="{Binding DownloadDocumentCommand}" 
              HorizontalAlignment="Left"/>

      <Button Grid.Column="1" 
              Content="Delete" 
              Command="{Binding DeleteDocumentCommand}" 
              HorizontalAlignment="Right" 
              Foreground="Red"/>
    </Grid>
  </StackPanel>
</UserControl>