<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:HRApplicantSystem.Data.Models"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             x:Class="HRApplicantSystem.UI.Views.Applicant.MyDocumentsView"
             x:DataType="vm:MyDocumentsViewModel">

  <StackPanel Margin="20" Spacing="12">

    <TextBlock
      Text="My Documents"
      FontSize="26"
      FontWeight="Bold"/>

    <Button
      Content="← Back"
      Command="{Binding GoBackCommand}"
      HorizontalAlignment="Left"/>

    <!-- RequirementTypeId UUID -->
    <ComboBox
      Width="300"
      ItemsSource="{Binding RequirementTypes}"
      SelectedItem="{Binding SelectedRequirementType}">

      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>

</ComboBox>

    <StackPanel
      Orientation="Horizontal"
      Spacing="10">

      <Button
        Content="+ Upload Document"
        Command="{Binding SelectAndUploadDocumentCommand}" />

      <Button
        Content="+ Record Video"
        IsEnabled="False"/>

    </StackPanel>

    <TextBlock
      Text="{Binding StatusMessage}"
      IsVisible="{Binding HasMessage}" />

    <TextBlock
      Text="Uploaded Documents"
      FontSize="18"
      FontWeight="Bold"/>

    <ListBox
      Height="320"
      ItemsSource="{Binding Documents}"
      SelectedItem="{Binding SelectedDocument}">

      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="10" Margin="0,0,0,10">
            <StackPanel Spacing="4">

              <!-- Document Type (PRETTY) -->
              <TextBlock
                Text="{Binding DocumentTypeName}"
                FontWeight="Bold"
                FontSize="14"/>

              <!-- File Name ONLY -->
              <TextBlock
                Text="{Binding FileName}"
                Opacity="0.8"/>

              <!-- Status -->
              <TextBlock
                Text="{Binding Status}"
                FontStyle="Italic"
                Opacity="0.7"/>

            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>

    </ListBox>

    <Grid ColumnDefinitions="*,*">

      <Button
        Grid.Column="0"
        Content="Open"
        Command="{Binding OpenDocumentCommand}" />

      <Button
        Grid.Column="1"
        Content="Delete"
        HorizontalAlignment="Right"
        Command="{Binding DeleteSelectedDocumentCommand}" />

    </Grid>

  </StackPanel>

</UserControl>