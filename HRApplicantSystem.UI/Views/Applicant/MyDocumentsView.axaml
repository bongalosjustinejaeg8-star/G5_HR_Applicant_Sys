<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.Applicant.MyDocumentsView"
             x:DataType="vm:MyDocumentsViewModel">

  <StackPanel Margin="20">
    <TextBlock Text="My Documents" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

    <Button Content="+ Upload Document" HorizontalAlignment="Left" Margin="0 0 0 10"/>
    <Button Content="+ Record Video" HorizontalAlignment="Left" Margin="0 0 0 15"/>

    <TextBlock Text="Uploaded Documents" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
    <ListBox ItemsSource="{Binding Documents}" Height="300" Margin="0 0 0 10">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="5">
            <TextBlock Text="{Binding DocumentName}" FontWeight="Bold"/>
            <TextBlock Text="Type: {Binding DocumentType}"/>
            <TextBlock Text="Uploaded: {Binding UploadedDate}"/>
            <TextBlock Text="Status: {Binding VerificationStatus}" 
                       Foreground="{Binding StatusColor}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid ColumnDefinitions="*,*" Margin="0 10 0 0">
      <Button Content="Download" HorizontalAlignment="Left"/>
      <Button Content="Delete" HorizontalAlignment="Right" Foreground="Red"/>
    </Grid>
  </StackPanel>
</UserControl>