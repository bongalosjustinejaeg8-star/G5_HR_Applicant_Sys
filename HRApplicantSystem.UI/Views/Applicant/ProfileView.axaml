<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             x:Class="HRApplicantSystem.UI.Views.Applicant.ProfileView"
             x:DataType="vm:ProfileViewModel">
  <ScrollViewer>
    <StackPanel Margin="20" Spacing="10">

      <!-- Header -->
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="← Back" Command="{Binding GoBackCommand}"/>
        <TextBlock Text="My Profile" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Status Message -->
      <Border Background="#DCFCE7" CornerRadius="6" Padding="12"
              IsVisible="{Binding HasMessage}">
        <TextBlock Text="{Binding StatusMessage}" Foreground="#166534"/>
      </Border>

      <!-- Personal Information -->
      <Border Background="#F9FAFB" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Personal Information" FontSize="16" FontWeight="Bold"/>
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
            <TextBlock Text="First Name" Grid.Row="0" Grid.Column="0" FontSize="12" Foreground="#6B7280"/>
            <TextBox Text="{Binding FirstName}" Grid.Row="0" Grid.Column="1" PlaceholderText="Enter first name" Height="36"/>
            <TextBlock Text="Last Name" Grid.Row="1" Grid.Column="0" FontSize="12" Foreground="#6B7280"/>
            <TextBox Text="{Binding LastName}" Grid.Row="1" Grid.Column="1" PlaceholderText="Enter last name" Height="36"/>
            <TextBlock Text="Email" Grid.Row="2" Grid.Column="0" FontSize="12" Foreground="#6B7280"/>
            <TextBox Text="{Binding Email}" Grid.Row="2" Grid.Column="1" IsEnabled="False" Height="36"/>
            <TextBlock Text="Phone" Grid.Row="3" Grid.Column="0" FontSize="12" Foreground="#6B7280"/>
            <TextBox Text="{Binding Phone}" Grid.Row="3" Grid.Column="1" PlaceholderText="Enter phone number" Height="36"/>
            <TextBlock Text="Address" Grid.Row="4" Grid.Column="0" FontSize="12" Foreground="#6B7280"/>
            <TextBox Text="{Binding Address}" Grid.Row="4" Grid.Column="1" PlaceholderText="Enter address" Height="36"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Education -->
      <Border Background="#F9FAFB" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Education" FontSize="16" FontWeight="Bold"/>
          <!-- Add Education Form -->
          <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NewDegree}" PlaceholderText="Degree (e.g. BS Computer Science)" Height="36"/>
            <TextBox Text="{Binding NewInstitution}" Grid.Column="1" PlaceholderText="School/University" Height="36"/>
            <Button Content="+ Add" Grid.Column="2" Command="{Binding AddEducationCommand}"
                    Background="#2563EB" Foreground="White" Padding="12,0" Height="36"/>
          </Grid>
          <!-- Education List -->
          <ListBox ItemsSource="{Binding EducationList}" MaxHeight="180">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="White" CornerRadius="6" Padding="10" Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Degree}" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="{Binding Institution}" Foreground="#6B7280" FontSize="12"/>
                      <TextBlock Text="{Binding GraduationYear}" Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                    <Button Content="✕" Grid.Column="1"
                            Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).RemoveEducationCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent" Foreground="#EF4444" Padding="8,0"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Work Experience -->
      <Border Background="#F9FAFB" CornerRadius="8" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="Work Experience" FontSize="16" FontWeight="Bold"/>
          <!-- Add Experience Form -->
          <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding NewJobTitle}" PlaceholderText="Job Title" Height="36"/>
            <TextBox Text="{Binding NewCompany}" Grid.Column="1" PlaceholderText="Company Name" Height="36"/>
            <Button Content="+ Add" Grid.Column="2" Command="{Binding AddExperienceCommand}"
                    Background="#2563EB" Foreground="White" Padding="12,0" Height="36"/>
          </Grid>
          <!-- Experience List -->
          <ListBox ItemsSource="{Binding WorkExperienceList}" MaxHeight="180">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="White" CornerRadius="6" Padding="10" Margin="0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding JobTitle}" FontWeight="Bold" FontSize="13"/>
                      <TextBlock Text="{Binding CompanyName}" Foreground="#6B7280" FontSize="12"/>
                    </StackPanel>
                    <Button Content="✕" Grid.Column="1"
                            Command="{Binding $parent[UserControl].((vm:ProfileViewModel)DataContext).RemoveExperienceCommand}"
                            CommandParameter="{Binding}"
                            Background="Transparent" Foreground="#EF4444" Padding="8,0"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- Skills -->
      <Border Background="#F9FAFB" CornerRadius="8" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Skills" FontSize="16" FontWeight="Bold"/>
          <TextBox Text="{Binding Skills}" PlaceholderText="Enter your skills (e.g. C#, SQL, Communication)"
                   Height="80" AcceptsReturn="True"/>
        </StackPanel>
      </Border>

      <!-- Save Button -->
      <Button Content="💾 Save Profile" Command="{Binding SaveCommand}"
              HorizontalAlignment="Right" Padding="20,12"
              Background="#2563EB" Foreground="White" FontWeight="Bold"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>