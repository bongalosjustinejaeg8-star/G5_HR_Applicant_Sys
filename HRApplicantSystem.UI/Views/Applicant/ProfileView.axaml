<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.Applicant.ProfileView"
             x:DataType="vm:ProfileViewModel">

  <ScrollViewer>
    <StackPanel Margin="20">
      <TextBlock Text="My Profile" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

      <!-- Personal Information -->
      <TextBlock Text="Personal Information" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0 0 0 15">
        <TextBlock Text="First Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Text="{Binding FirstName}" Grid.Row="0" Grid.Column="1" Margin="10 0 0 0"/>

        <TextBlock Text="Last Name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0 5 0 0"/>
        <TextBox Text="{Binding LastName}" Grid.Row="1" Grid.Column="1" Margin="10 5 0 0"/>

        <TextBlock Text="Email:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0 5 0 0"/>
        <TextBox Text="{Binding Email}" Grid.Row="2" Grid.Column="1" Margin="10 5 0 0" IsEnabled="False"/>

        <TextBlock Text="Phone:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0 5 0 0"/>
        <TextBox Text="{Binding Phone}" Grid.Row="3" Grid.Column="1" Margin="10 5 0 0"/>
      </Grid>

      <!-- Education -->
      <TextBlock Text="Education" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
      <ListBox ItemsSource="{Binding EducationList}" Height="150" Margin="0 0 0 15">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="5">
              <TextBlock Text="{Binding Degree}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Institution}"/>
              <TextBlock Text="{Binding GraduationYear}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="+ Add Education" HorizontalAlignment="Left" Margin="0 0 0 15"/>

      <!-- Work Experience -->
      <TextBlock Text="Work Experience" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
      <ListBox ItemsSource="{Binding WorkExperienceList}" Height="150" Margin="0 0 0 15">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="5">
              <TextBlock Text="{Binding JobTitle}" FontWeight="Bold"/>
              <TextBlock Text="{Binding CompanyName}"/>
              <TextBlock Text="{Binding StartDate} - {Binding EndDate}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="+ Add Experience" HorizontalAlignment="Left" Margin="0 0 0 15"/>

      <Button Content="Save Changes" HorizontalAlignment="Right"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>