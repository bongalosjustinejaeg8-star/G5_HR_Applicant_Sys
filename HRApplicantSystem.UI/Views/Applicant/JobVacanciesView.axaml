<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             xmlns:m="using:HRApplicantSystem.Data.Models"
             x:Class="HRApplicantSystem.UI.Views.Applicant.JobVacanciesView"
             x:DataType="vm:JobVacanciesViewModel">

  <StackPanel Margin="20">

    <TextBlock Text="Job Vacancies"
               FontSize="24"
               FontWeight="Bold"
               Margin="0 0 0 20"/>

    <TextBox Text="{Binding SearchText}"
             Watermark="Search jobs..."
             Margin="0 0 0 10"/>

    <ListBox ItemsSource="{Binding Vacancies}"
             SelectedItem="{Binding SelectedJob}"
             Height="300"
             Margin="0 0 0 10">

      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="m:JobVacancy">
          <StackPanel Margin="5">

            <TextBlock Text="{Binding PositionTitle}"
                       FontSize="14"
                       FontWeight="Bold"/>

            <TextBlock Text="{Binding DepartmentId}"/>

            <TextBlock Text="{Binding EmploymentType}"/>

            <TextBlock Text="{Binding Status}"/>

            <TextBlock Text="{Binding CreatedAt}"/>

          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>

    </ListBox>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">

      <Button Content="Apply Now"
              Command="{Binding ApplyCommand}"/>

    </StackPanel>

  </StackPanel>
</UserControl>