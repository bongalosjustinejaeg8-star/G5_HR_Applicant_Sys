<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             xmlns:m="using:HRApplicantSystem.Data.Models"
             x:Class="HRApplicantSystem.UI.Views.Applicant.JobVacanciesView"
             x:DataType="vm:JobVacanciesViewModel">

  <StackPanel Margin="20">
    <TextBlock Text="Job Vacancies" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

    <!-- Debug Message -->
    <TextBlock Text="{Binding Message}" 
               IsVisible="{Binding HasMessage}"
               Foreground="Blue" 
               Margin="0 0 0 10"/>

    <!-- Search and Filter -->
    <Grid ColumnDefinitions="*,*" Margin="0 0 0 10">
      <TextBox Text="{Binding SearchText}" PlaceholderText="Search jobs..." Margin="0,0,0,10"/>
    </Grid>

    <!-- Job Vacancies ListBox -->
    <ListBox ItemsSource="{Binding Vacancies}"
             SelectedItem="{Binding SelectedJob}"
             Height="300"
             Margin="0 0 0 10">

      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="m:JobVacancy">
          <StackPanel Margin="5">
            <TextBlock Text="{Binding PositionTitle}" FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="{Binding DepartmentId}" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0 2 0 0">
              <TextBlock Text="Type: " FontSize="10"/>
              <TextBlock Text="{Binding EmploymentType}" FontSize="10"/>
            </StackPanel>
            <TextBlock Text="{Binding CreatedAt, StringFormat='Posted: {0:yyyy-MM-dd}'}" FontSize="10" Foreground="Gray"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate> 

    </ListBox>

    <Border Background="#F0F9FF" CornerRadius="8" Padding="15" Margin="0,10,0,0"
            IsVisible="{Binding SelectedJob, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding SelectedJob.PositionTitle}" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="{Binding SelectedJob.EmploymentType}" Foreground="#2563EB" FontSize="12"/>
        <TextBlock Text="Qualifications:" FontWeight="SemiBold" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding SelectedJob.Qualifications}" TextWrapping="Wrap" Foreground="#374151"/>
      </StackPanel>
  </Border>

    <!-- Action Buttons -->
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
      <Button Content="← Back" Command="{Binding GoBackCommand}"/>
      <Button Content="Apply Now"
              Command="{Binding ApplyAsync}"
              IsEnabled="{Binding CanApply}"
              Background="#2563EB"
              Foreground="White"
              Padding="15,8"
        ToolTip.Tip="Select a job first"/>
</StackPanel>
  </StackPanel>
</UserControl>
