<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels.Applicant"
             x:Class="HRApplicantSystem.UI.Views.Applicant.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="Black"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">

      <!-- Header -->
      <TextBlock Text="Welcome Back!"
                 FontSize="28"
                 FontWeight="Bold"/>

      <!-- Status Card -->
      <Border Background="#2563EB"
              CornerRadius="12"
              Padding="20">

        <StackPanel Spacing="8">

          <TextBlock Text="Current Application Status"
                     Foreground="White"
                     Opacity="0.9"/>

          <TextBlock Text="{Binding CurrentApplicationStatus}"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="White"/>

          <TextBlock Text="{Binding ApplicationSubmittedDate}"
                     Foreground="White"
                     Opacity="0.75"/>

        </StackPanel>

      </Border>

      <!-- Quick Stats -->
      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="12">

        <Border Background="#F5F5F5"
                CornerRadius="10"
                Padding="16">
          <StackPanel>
            <TextBlock Text="Missing Docs"/>
            <TextBlock Text="{Binding MissingDocuments.Count}"
                       FontSize="24"
                       FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#F5F5F5"
                CornerRadius="10"
                Padding="16">
          <StackPanel>
            <TextBlock Text="Interviews"/>
            <TextBlock Text="{Binding UpcomingInterviews.Count}"
                       FontSize="24"
                       FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Background="#F5F5F5"
                CornerRadius="10"
                Padding="16">
          <StackPanel>
            <TextBlock Text="Profile Completion"/>
            <TextBlock Text="85%"
                       FontSize="24"
                       FontWeight="Bold"/>
          </StackPanel>
        </Border>

      </Grid>
      <!-- Navigation Buttons -->
      <!-- Navigation Buttons -->
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="🔍 Browse &amp; Apply for Jobs" Command="{Binding GoToJobVacanciesCommand}" Padding="15,10" Background="#2563EB" Foreground="White"/>
          <Button Content="📄 My Application" Command="{Binding GoToMyApplicationCommand}" Padding="15,10" Background="#059669" Foreground="White"/>
          <Button Content="📊 Status Timeline" Command="{Binding GoToStatusTrackingCommand}" Padding="15,10" Background="#7C3AED" Foreground="White"/>
          <Button Content="👤 Profile" Command="{Binding GoToProfileCommand}" Padding="15,10" Background="#6B7280" Foreground="White"/>
          <Button Content="🚪 Logout" Command="{Binding LogoutCommand}" Padding="15,10" Background="#EF4444" Foreground="White"/>
        </StackPanel>
        <TextBlock Text="💡 Documents are uploaded as part of the job application process — click 'Browse &amp; Apply for Jobs' to apply and attach your documents."
                   FontSize="11" Foreground="#6B7280" Margin="0,2,0,0"/>
      </StackPanel>

      <!-- Main Content -->
      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="15">

        <!-- Missing Documents -->
        <Border Background="#FAFAFA"
                CornerRadius="12"
                Padding="16">

          <StackPanel Spacing="10">

            <TextBlock Text="Missing Documents"
                       FontSize="18"
                       FontWeight="Bold"/>

            <ListBox ItemsSource="{Binding MissingDocuments}"
                     Height="220">

              <ListBox.ItemTemplate>
                <DataTemplate>

                  <Border Background="White"
                          CornerRadius="8"
                          Padding="10"
                          Margin="4">

                    <StackPanel>
                      <TextBlock Text="{Binding DocumentName}"
                                 Foreground="#DC2626"
                                 FontWeight="Bold"/>

                      <TextBlock Text="{Binding DueDate}"
                                 FontSize="12"
                                 Opacity="0.7"/>
                    </StackPanel>

                  </Border>

                </DataTemplate>
              </ListBox.ItemTemplate>

            </ListBox>

          </StackPanel>

        </Border>

        <!-- Interviews -->
        <Border Grid.Column="1"
                Background="#FAFAFA"
                CornerRadius="12"
                Padding="16">

          <StackPanel Spacing="10">

            <TextBlock Text="Upcoming Interviews"
                       FontSize="18"
                       FontWeight="Bold"/>

            <ListBox ItemsSource="{Binding UpcomingInterviews}"
                     Height="220">

              <ListBox.ItemTemplate>
                <DataTemplate>

                  <Border Background="White"
                          CornerRadius="8"
                          Padding="10"
                          Margin="4">

                    <StackPanel>
                      <TextBlock Text="{Binding InterviewType}"
                                 FontWeight="Bold"/>

                      <TextBlock Text="{Binding ScheduledDate}"/>

                      <TextBlock Text="{Binding Mode}"
                                 Opacity="0.7"/>
                    </StackPanel>

                  </Border>

                </DataTemplate>
              </ListBox.ItemTemplate>

            </ListBox>

          </StackPanel>

        </Border>

      </Grid>

    </StackPanel>
  </ScrollViewer>

</UserControl>