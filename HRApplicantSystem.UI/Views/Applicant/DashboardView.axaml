<UserControl x:CompileBindings="False"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.Applicant.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">

      <!-- Header -->
      <TextBlock Text="Welcome Back!"
                 FontSize="28"
                 FontWeight="Bold"/>

      <!-- Status Card -->
      <Border Background="#2563EB"
              CornerRadius="12"
              Padding="20">

        <StackPanel Spacing="8">

          <TextBlock Text="Current Application Status"
                     Foreground="White"
                     Opacity="0.9"/>

          <TextBlock Text="{Binding CurrentApplicationStatus}"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="White"/>

          <TextBlock Text="{Binding ApplicationSubmittedDate}"
                     Foreground="White"
                     Opacity="0.75"/>

        </StackPanel>

      </Border>

      <!-- Quick Stats -->
      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="12">

        <Border Background="#F5F5F5"
                CornerRadius="10"
                Padding="16">
          <StackPanel>
            <TextBlock Text="Missing Docs"/>
            <TextBlock Text="{Binding MissingDocuments.Count}"
                       FontSize="24"
                       FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#F5F5F5"
                CornerRadius="10"
                Padding="16">
          <StackPanel>
            <TextBlock Text="Interviews"/>
            <TextBlock Text="{Binding UpcomingInterviews.Count}"
                       FontSize="24"
                       FontWeight="Bold"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Background="#F5F5F5"
                CornerRadius="10"
                Padding="16">
          <StackPanel>
            <TextBlock Text="Profile Completion"/>
            <TextBlock Text="85%"
                       FontSize="24"
                       FontWeight="Bold"/>
          </StackPanel>
        </Border>

      </Grid>

      <!-- Main Content -->
      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="15">

        <!-- Missing Documents -->
        <Border Background="#FAFAFA"
                CornerRadius="12"
                Padding="16">

          <StackPanel Spacing="10">

            <TextBlock Text="Missing Documents"
                       FontSize="18"
                       FontWeight="Bold"/>

            <ListBox ItemsSource="{Binding MissingDocuments}"
                     Height="220">

              <ListBox.ItemTemplate>
                <DataTemplate>

                  <Border Background="White"
                          CornerRadius="8"
                          Padding="10"
                          Margin="4">

                    <StackPanel>
                      <TextBlock Text="{Binding DocumentName}"
                                 Foreground="#DC2626"
                                 FontWeight="Bold"/>

                      <TextBlock Text="{Binding DueDate}"
                                 FontSize="12"
                                 Opacity="0.7"/>
                    </StackPanel>

                  </Border>

                </DataTemplate>
              </ListBox.ItemTemplate>

            </ListBox>

          </StackPanel>

        </Border>

        <!-- Interviews -->
        <Border Grid.Column="1"
                Background="#FAFAFA"
                CornerRadius="12"
                Padding="16">

          <StackPanel Spacing="10">

            <TextBlock Text="Upcoming Interviews"
                       FontSize="18"
                       FontWeight="Bold"/>

            <ListBox ItemsSource="{Binding UpcomingInterviews}"
                     Height="220">

              <ListBox.ItemTemplate>
                <DataTemplate>

                  <Border Background="White"
                          CornerRadius="8"
                          Padding="10"
                          Margin="4">

                    <StackPanel>
                      <TextBlock Text="{Binding InterviewType}"
                                 FontWeight="Bold"/>

                      <TextBlock Text="{Binding ScheduledDate}"/>

                      <TextBlock Text="{Binding Mode}"
                                 Opacity="0.7"/>
                    </StackPanel>

                  </Border>

                </DataTemplate>
              </ListBox.ItemTemplate>

            </ListBox>

          </StackPanel>

        </Border>

      </Grid>

    </StackPanel>
  </ScrollViewer>

</UserControl>