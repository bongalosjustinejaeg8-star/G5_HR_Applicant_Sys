<UserControl x:CompileBindings="False" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.Applicant.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <StackPanel Margin="20">
    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

    <!-- Application Status Card -->
    <Border Background="#F0F0F0" Padding="15" CornerRadius="5" Margin="0 0 0 15">
      <StackPanel>
        <TextBlock Text="Application Status" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
        <TextBlock Text="{Binding CurrentApplicationStatus}" FontSize="14" Foreground="Blue"/>
        <TextBlock Text="{Binding ApplicationSubmittedDate}" FontSize="12" Foreground="Gray"/>
      </StackPanel>
    </Border>

    <!-- Missing Documents -->
    <TextBlock Text="Missing Documents" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
    <ListBox ItemsSource="{Binding MissingDocuments}" Height="120" Margin="0 0 0 15">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="5">
            <TextBlock Text="{Binding DocumentName}" FontWeight="Bold" Foreground="Red"/>
            <TextBlock Text="{Binding DueDate}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Interview Schedule -->
    <TextBlock Text="Upcoming Interviews" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>
    <ListBox ItemsSource="{Binding UpcomingInterviews}" Height="150">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="5">
            <TextBlock Text="{Binding InterviewType}" FontWeight="Bold"/>
            <TextBlock Text="{Binding ScheduledDate}"/>
            <TextBlock Text="{Binding Mode}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</UserControl>