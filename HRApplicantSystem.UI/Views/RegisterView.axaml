<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:HRApplicantSystem.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="HRApplicantSystem.UI.Views.RegisterView"
             x:DataType="viewModels:RegisterViewModel">

    <UserControl.DataContext>
        <viewModels:RegisterViewModel/>
    </UserControl.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#3D3D3D"/>
            <Setter Property="BorderBrush" Value="#4D4D4D"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="#121212">
        <Border Background="#1E1E1E" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Width="380">
            <StackPanel Spacing="15">

                <TextBlock Text="Create an Account" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Full Name" Foreground="#DDDDDD" FontSize="13" FontWeight="Medium"/>
                    <TextBox Text="{Binding FullName, Mode=TwoWay}" PlaceholderText="Enter your full name" Background="#3D3D3D" Foreground="#FFFFFF" BorderBrush="#4D4D4D" CornerRadius="6" Padding="10,8"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Email address" Foreground="#DDDDDD" FontSize="13" FontWeight="Medium"/>
                    <TextBox Text="{Binding Email, Mode=TwoWay}" PlaceholderText="user@email.com" Background="#3D3D3D" Foreground="#FFFFFF" BorderBrush="#4D4D4D" CornerRadius="6" Padding="10,8"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Password" Foreground="#DDDDDD" FontSize="13" FontWeight="Medium"/>
                    <TextBox Text="{Binding Password, Mode=TwoWay}" PlaceholderText="Enter password" PasswordChar="*" Background="#3D3D3D" Foreground="#FFFFFF" BorderBrush="#4D4D4D" CornerRadius="6" Padding="10,8"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Confirm Password" Foreground="#DDDDDD" FontSize="13" FontWeight="Medium"/>
                    <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}" PlaceholderText="Re-enter password" PasswordChar="*" Background="#3D3D3D" Foreground="#FFFFFF" BorderBrush="#4D4D4D" CornerRadius="6" Padding="10,8"/>
                </StackPanel>

                <Button Content="Sign Up"
                        Command="{Binding RegisterCommand}"
                        Background="#3D3D3D" Foreground="#FFFFFF" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,12" CornerRadius="6" Margin="0,10,0,0" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0" Spacing="5">
                    <TextBlock Text="Already have an account?" Foreground="#AAAAAA" FontSize="13"/>
                    <Button Content="Sign In"
                            Command="{Binding $parent[Window].((viewModels:MainWindowViewModel)DataContext).NavigateToLoginCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Padding="0" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>