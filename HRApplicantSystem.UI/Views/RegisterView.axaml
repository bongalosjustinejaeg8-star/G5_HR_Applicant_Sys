<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             x:Class="HRApplicantSystem.UI.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <Grid Background="#121212">
        <Border Background="#1E1E1E" Width="400" Padding="30" CornerRadius="8" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                BorderBrush="#2D2D2D" BorderThickness="1">
            <StackPanel Spacing="15">
                <TextBlock Text="Create an Account" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Join us and monitor your application" Foreground="#888888" FontSize="12" HorizontalAlignment="Center"/>
                
                <Separator Background="#2D2D2D" Margin="0,10"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Full Name" Foreground="#888888" FontSize="12"/>
                    <TextBox Text="{Binding RegUsername}" Background="#2D2D2D" Foreground="White"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Email Address" Foreground="#888888" FontSize="12"/>
                    <TextBox Background="#2D2D2D" Foreground="White"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Password" Foreground="#888888" FontSize="12"/>
                    <TextBox Text="{Binding RegPassword}" PasswordChar="*" Background="#2D2D2D" Foreground="White"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Confirm Password" Foreground="#888888" FontSize="12"/>
                    <TextBox Text="{Binding ConfirmPassword}" PasswordChar="*" Background="#2D2D2D" Foreground="White"/>
                </StackPanel>

                <!-- SIGN UP BUTTON -->
                <Button Content="Sign Up" 
                        Command="{Binding RegisterCommand}" 
                        Background="#007ACC" Foreground="White" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                        Padding="10" Margin="0,10,0,0"/>

                <!-- SIGN IN FOOTER LINK -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Spacing="5">
                    <TextBlock Text="Already have an account?" Foreground="#888888" FontSize="12"/>
                    <Button Content="Sign In" 
                            Command="{Binding BackToLoginCommand}" 
                            Background="Transparent" Foreground="#007ACC" 
                            Padding="0" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>