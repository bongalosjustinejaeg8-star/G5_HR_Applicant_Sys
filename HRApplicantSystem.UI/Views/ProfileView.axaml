<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HRApplicantSystem.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="HRApplicantSystem.UI.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">

    <Border Background="#121212" Padding="30">
        <StackPanel Spacing="25">
            
            <TextBlock Text="Admin Profile" Foreground="#FFFFFF" FontSize="24" FontWeight="Bold"/>

            <Border Background="#1E1E1E" BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="12" Padding="25" MaxWidth="500" HorizontalAlignment="Left">
                <StackPanel Spacing="20">
                    
                    <Border Width="80" Height="80" Background="#3D3D3D" CornerRadius="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Full Name" Foreground="#AAAAAA" FontSize="12" FontWeight="Medium"/>
                            <TextBox Text="{Binding AdminName, Mode=TwoWay}" 
                                     IsReadOnly="{Binding !IsEditMode}" 
                                     CornerRadius="6" 
                                     Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Email Address" Foreground="#AAAAAA" FontSize="12" FontWeight="Medium"/>
                            <TextBox Text="{Binding Email, Mode=TwoWay}" 
                                     IsReadOnly="{Binding !IsEditMode}" 
                                     CornerRadius="6" 
                                     Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Designated Role" Foreground="#AAAAAA" FontSize="12" FontWeight="Medium"/>
                            <TextBox Text="{Binding Role, Mode=TwoWay}" 
                                     IsReadOnly="{Binding !IsEditMode}" 
                                     CornerRadius="6" 
                                     Padding="10,8"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Department" Foreground="#AAAAAA" FontSize="12" FontWeight="Medium"/>
                            <TextBox Text="{Binding Department, Mode=TwoWay}" 
                                     IsReadOnly="{Binding !IsEditMode}" 
                                     CornerRadius="6" 
                                     Padding="10,8"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="{Binding ButtonText}" 
                            Command="{Binding ToggleEditCommand}" 
                            Background="#3D3D3D" 
                            Foreground="#FFFFFF" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center" 
                            Padding="10" 
                            CornerRadius="6" 
                            FontWeight="SemiBold" 
                            Margin="0,10,0,0"/>

                </StackPanel>
            </Border>
            
        </StackPanel>
    </Border>
</UserControl>
